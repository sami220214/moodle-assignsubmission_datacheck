<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/assign/submission/datacheck/db" VERSION="20261110" COMMENT="HAMK assignment privacy declaration"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="assignsubmission_datacheck" COMMENT="Student declaration about personal and sensitive information">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="submission" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="answer" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="unsure" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="assignment_fk" TYPE="foreign" FIELDS="assignment" REFTABLE="assign" REFFIELDS="id"/>
        <KEY NAME="submission_fk" TYPE="foreign" FIELDS="submission" REFTABLE="assign_submission" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submission_unique" UNIQUE="true" FIELDS="submission"/>
        <INDEX NAME="assignment_idx" UNIQUE="false" FIELDS="assignment"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
